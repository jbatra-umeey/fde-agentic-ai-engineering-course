# Generate identities with: python scripts/dev_credentials.py
# Never copy test tokens into a deployed system. This example contains no credentials.
JEV_PLANNER=fixture
JEV_DB=var/jev.sqlite
JEV_MAX_CONCURRENT_RUNS=4
# To enable configured multi-provider inference:
# JEV_PLANNER=router
# JEV_MODELS_CONFIG=config/models.local.json
# Supply OPENAI_API_KEY / ANTHROPIC_API_KEY through your environment or secret manager.
# Optional metadata-only OTLP exporters:
# JEV_OTLP_TRACES_ENDPOINT=http://collector:4318/v1/traces
# JEV_OTLP_METRICS_ENDPOINT=http://collector:4318/v1/metrics
